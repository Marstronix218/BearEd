# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Relative paths are resolved from the repo root.

# --- Slide + narration generation (slide_audio_gen) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Lip-sync (Wav2Lip) ---
# Wav2Lip checkpoint (auto-downloaded to this default path)
WAV2LIP_CHECKPOINT=Wav2Lip-master/checkpoints/wav2lip_gan.pth
# Talking-head clip (or a single photo) of the presenter; looped to narration length
FACE_VIDEO=assets/face.mp4
# Extra Wav2Lip flags, e.g. --pads 0 20 0 0 --nosmooth
# (the face is already shrunk to fit 720px, so --resize_factor is rarely needed)
WAV2LIP_ARGS=

# Both model files (wav2lip_gan.pth and the s3fd.pth face detector) are
# downloaded automatically on first run and checksum-verified (see weights.py).
